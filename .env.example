# Bot token de @BotFather. Formato: <numeric>:<secret>
TELEGRAM_TOKEN=1234567890:AAAA...

# Chat IDs autorizados (coma-separado). Envía /start a @userinfobot en
# Telegram para obtener el tuyo. VACÍO = cualquiera puede usar el bot (DEV).
OWNER_CHAT_IDS=1546227433

# Ruta del store persistente (default: prices.json en cwd).
DATA_FILE=prices.json

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Cuántas entradas del histórico guarda por producto (120 = ~10 días a 2h/check).
HISTORY_LIMIT=120

# Cron schedules (formato cron estándar).
CHECK_CRON=0 */2 * * *
SUMMARY_CRON=0 20 * * *

# Timeouts / paces.
PLAYWRIGHT_TIMEOUT_MS=60000
SCRAPE_PAUSE_MS=900

# User-Agent del scraper (default: Chrome 131 Win64).
# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 ...
